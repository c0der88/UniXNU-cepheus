+		cepheus_log_lock_note = 1;
+		cepheus_early_mark(20, "L0 bsd_log_lock entered");
+		if (lw[0] == 0u && lw[1] == 0u && lw[2] == 0u && lw[3] == 0u) {
+			cepheus_early_mark(19, "L1 log_lock is ALL ZERO (never initialised)");
+		} else {
+			cepheus_early_mark(17, "L1 log_lock has initialiser data");
+		}
+	}
